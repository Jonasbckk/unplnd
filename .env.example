# Copy this file to ".env" and fill in the values. Only PUBLIC client values belong here —
# everything secret (Google Maps, Gemini/Anthropic, RevenueCat secret key, webhook secret,
# service_role) lives ONLY as Supabase Edge Function secrets.

# Supabase → Project Settings → API (or "Connect")
#   Project URL               → EXPO_PUBLIC_SUPABASE_URL
#   anon / publishable key    → EXPO_PUBLIC_SUPABASE_ANON_KEY  (safe in the app, protected by RLS)
# NEVER put the service_role key or the database password in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat → Project → API keys → PUBLIC app-specific keys (iOS starts with appl_, Android with goog_).
# Without them the paywall stays hidden (no dead purchase button).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional — Sentry → Project → Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Optional — PostHog → Project settings → Project API key (phc_…) + host (e.g. https://eu.i.posthog.com)
EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com   (leave commented to use the EU default)
