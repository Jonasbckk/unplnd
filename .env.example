# Copy this file to ".env" and fill in your Supabase project values.
# Find them in: Supabase Dashboard → your project → Settings (gear) → API
#   - "Project URL"                → EXPO_PUBLIC_SUPABASE_URL
#   - "Project API keys" → "anon public" → EXPO_PUBLIC_SUPABASE_ANON_KEY
# The anon key is safe to embed in the app (protected by Row Level Security).
# NEVER put the service_role key or the database password in this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
