{
  "expo": {
    "name": "UNPLND",
    "slug": "unplnd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unplnd",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unplnd.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.unplnd.app",
      "adaptiveIcon": {
        "backgroundColor": "#F9F4EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F4EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#171412",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UNPLND nutzt deinen Standort, um großartige Orte in deiner Nähe zu finden.",
          "locationAlwaysAndWhenInUsePermission": "UNPLND nutzt deinen Standort nur, während du die App verwendest – um Orte in deiner Nähe zu finden und dich durch deinen Abend zu führen.",
          "locationAlwaysPermission": "UNPLND nutzt deinen Standort nur, während du die App verwendest – um Orte in deiner Nähe zu finden und dich durch deinen Abend zu führen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UNPLND braucht Zugriff auf deine Fotos, damit du Erinnerungen zu deinen Alben hinzufügen kannst."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Lavender",
            "ios": "./assets/images/app-icons/lavender.png"
          },
          {
            "name": "Mint",
            "ios": "./assets/images/app-icons/mint.png"
          },
          {
            "name": "Lime",
            "ios": "./assets/images/app-icons/lime.png"
          },
          {
            "name": "Holographic",
            "ios": "./assets/images/app-icons/holographic.png"
          }
        ]
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "UNPLND braucht das Mikrofon, damit du deinen Abend dem Concierge einfach erzählen und Sprachnachrichten im Chat aufnehmen kannst."
        }
      ],
      "expo-asset",
      "expo-video",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b8e2333a-7f76-414d-b2e2-5c1ea5e6dc44"
      }
    }
  }
}
